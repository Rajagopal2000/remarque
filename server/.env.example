# Answer provider: claude-code (default, claude.ai subscription via Claude Code CLI),
# codex (ChatGPT subscription via codex CLI), gemini (experimental, gemini CLI),
# claude (Anthropic API key), openai (OpenAI-compatible API).
PROVIDER=claude-code
# Transcription provider; empty = same as PROVIDER.
# TRANSCRIBE_PROVIDER=

# Model split per provider: cheap model reads the handwriting, strong model answers.
# CLAUDE_CODE_MODEL=sonnet              # answers (or opus on Max plans)
# CLAUDE_CODE_TRANSCRIBE_MODEL=sonnet   # haiku is cheaper but reads handwriting worse
# For local transcription instead (e.g. Ollama with a vision model, no cloud call):
# TRANSCRIBE_PROVIDER=openai
# OPENAI_BASE_URL=http://ollama:11434/v1
# OPENAI_API_KEY=ollama                 # any non-empty value for Ollama
# OPENAI_TRANSCRIBE_MODEL=qwen2.5vl:7b
# CODEX_MODEL=                          # empty = codex CLI default
# CODEX_TRANSCRIBE_MODEL=
# GEMINI_MODEL=
# GEMINI_TRANSCRIBE_MODEL=gemini-2.5-flash
# ANTHROPIC_API_KEY=sk-ant-...          # only for PROVIDER=claude
# ANTHROPIC_MODEL=claude-opus-4-8
# ANTHROPIC_TRANSCRIBE_MODEL=claude-haiku-4-5
# OPENAI_API_KEY=sk-...                 # only for PROVIDER=openai
# OPENAI_MODEL=gpt-4o
# OPENAI_TRANSCRIBE_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=                      # any OpenAI-compatible gateway (LiteLLM, OpenRouter, Ollama)

# Shared secret the tablet must send as X-Api-Token; empty disables auth (dev only).
# Bake the same value into the device app: API_TOKEN=... ./scripts/deploy-app.sh device-app
# API_TOKEN=

# Per-document sessions (claude-code and codex): expire after this many idle days.
SESSION_TTL_DAYS=730

# Optional: AnkiConnect endpoint for pushing generated decks straight into Anki
# and syncing to AnkiWeb (Anki desktop must run with the AnkiConnect add-on; set
# its webBindAddress to 0.0.0.0 if the server is not on the same machine).
# ANKI_CONNECT_URL=http://192.168.4.20:8765

# Optional: refresh existing Anki decks incrementally every N hours (0 = off).
# Only documents whose deck was created once (Anki button) are updated, and
# unchanged documents skip the LLM entirely.
# ANKI_AUTO_HOURS=24

# Optional: folder inside an Obsidian vault; when set, notes export also writes
# a markdown note (highlights + Q&A) per document there.
# OBSIDIAN_DIR=/Users/you/Obsidian/Vault/Remarque

# Optional: write a reading digest note (documents read, questions, quiz
# performance, margin notes; no LLM call) into OBSIDIAN_DIR every N days.
# DIGEST_EVERY_DAYS=7

# Tablet connection. 10.11.99.1 is the USB address; use the WiFi LAN IP otherwise.
RM_HOST=10.11.99.1
# SSH_KEY_PATH=/Users/you/.ssh/id_remarkable

# Where synced tablet data, sessions, and history live (defaults to ~/.remarque)
# REMARQUE_DATA_DIR=/Users/you/.remarque

# Only needed when running headless Claude Code in a container without an
# interactive login (generate with: claude setup-token).
# CLAUDE_CODE_OAUTH_TOKEN=sk-ant-oat01-...

# Advanced overrides (defaults in app/config.py are fine for normal use):
# RM_USER=root                          # ssh user on the tablet
# XOCHITL_REMOTE_DIR=/home/root/.local/share/remarkable/xochitl
# SYNC_DIR=                             # where synced documents land
# HISTORY_DB=                           # sqlite for history/sessions/anki state
# AGENT_HOME=                           # stable cwd for agent sessions
# SYNC_MAX_AGE=60                       # skip syncs fresher than this (seconds)
# MAX_ANSWER_TOKENS=8000
# MAX_DOC_CHARS=150000
